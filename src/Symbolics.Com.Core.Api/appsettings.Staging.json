{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "apiKey": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Qdrant": {
    "UrlHttp": "",
    "UrlGrpc": "",
    "ApiKey": ""
  },
  "Twitch": {
    "BaseUrl": "https://api.twitch.tv/helix"
  },
  "TwitchDiscovery": {
    "PollingInterval": "00:05:00",
    "CleanupInterval": "06:00:00",
    "MaxRetryAttempts": 3,
    "RetryDelay": "00:00:02"
  },
  "TwitchEnrichment": {
    "PollingInterval": "00:05:00",
    "StreamerMaxRetryCount": 3,
    "GameMaxRetryCount": 3,
    "MaxConcurrentRequests": 4
  },
  "IgdbRefresh": {
    "PollingInterval": "1.00:00:00",
    "RetryInterval": "7.00:00:00",
    "MaxConcurrentRequests": 4
  },
  "StreamMaintenance": {
    "RetentionDuration": "30.00:00:00"
  },
  "Recommendations": {
    "TopGamesLimit": 500,
    "CacheTtlMinutes": 30
  }
}
