{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Log": {
    "SeqUrl": "http://localhost:5341",
    "SeqHealthUrl": "http://localhost:37004"
  },
  "Qdrant": {
    "UrlHttp": "http://localhost:6333",
    "UrlGrpc": "",
    "ApiKey": ""
  },
  "Ai": {
    "EmbeddingBaseUrl": "https://ai.example.com/embeddings",
    "EmbeddingDimensions": 1536
  },
  "Gemini": { 
    "DescriptionBaseUrl": "https://generativelanguage.googleapis.com/v1alpha",
    "DescriptionModel": "gemini-2.5-flash-lite",
    "EmbeddingBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingDimensions": 1536,
    "EmbeddingApiKey": ""
  },
  "TwitchDiscovery": {
    "PollingInterval": "00:05:00",
    "CleanupInterval": "06:00:00",
    "MaxRetryAttempts": 3,
    "RetryDelay": "00:00:02"
  },
  "TwitchEnrichment": {
    "PollingInterval": "00:05:00",
    "StreamerMaxRetryCount": 3,
    "GameMaxRetryCount": 3,
    "MaxConcurrentRequests": 4
  },
  "StreamMaintenance": {
    "RetentionDuration": "30.00:00:00"
  },
  "Admin": {
    "AdminKey": "0123456789"
  },
  "Swagger": {
    "Username": "admin",
    "Password": "swagger123"
  },
  "Service": {
    "ServiceKey": ""
  },
  "AllowedHosts": "*"
}
