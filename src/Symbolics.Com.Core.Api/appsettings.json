{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Log": {
    "SeqUrl": "http://localhost:5341",
    "SeqHealthUrl": "http://localhost:37004"
  },
  "Qdrant": {
    "Url": "http://localhost:6333",
    "ApiKey": ""
  },
  "TwitchDiscovery": {
    "PollingInterval": "00:05:00",
    "CleanupInterval": "06:00:00",
    "MaxRetryAttempts": 3,
    "RetryDelay": "00:00:02"
  },
  "TwitchEnrichment": {
    "PollingInterval": "00:05:00",
    "StreamerMaxRetryCount": 3,
    "GameMaxRetryCount": 3,
    "MaxConcurrentRequests": 4
  },
  "AllowedHosts": "*"
}
