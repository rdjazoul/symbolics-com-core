{
  "ConnectionStrings": {
    "CoreDatabase": "Host=localhost;Database=symbolics_core;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "LogOptions": {
    "SeqUrl": "http://localhost:5341",
    "MinimumLevel": "Debug"
  },
  "Qdrant": {
    "UrlHttp": "http://localhost:37002",
    "UrlGrpc": "http://localhost:6334",
    "ApiKey": ""
  },
  "Ai": {
    "DescriptionBaseUrl": "https://ai.example.com/descriptions",
    "DescriptionApiKey": "",
    "EmbeddingBaseUrl": "https://ai.example.com/embeddings",
    "EmbeddingApiKey": "",
    "EmbeddingDimensions": 1536
  },
  "Twitch": {
    "BaseUrl": "https://api.twitch.tv/helix",
    "ClientId": "",
    "ClientSecret": ""
  }
}
