{
  "ConnectionStrings": {
    "CoreDatabase": "Host=localhost;Database=symbolics_core;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:37005",
          "apiKey": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Log": {
    "SeqUrl": "http://localhost:37005",
    "SeqHealthUrl": "http://localhost:37004"
  },
  "Qdrant": {
    "UrlHttp": "http://localhost:37002",
    "UrlGrpc": "http://localhost:6334",
    "ApiKey": ""
  },
  "Ai": {
    "DescriptionBaseUrl": "https://ai.example.com/descriptions",
    "DescriptionApiKey": "",
    "EmbeddingBaseUrl": "https://ai.example.com/embeddings",
    "EmbeddingApiKey": "",
    "EmbeddingDimensions": 1536
  },
  "Twitch": {
    "BaseUrl": "https://api.twitch.tv/helix",
    "ClientId": "",
    "ClientSecret": ""
  },
  "TwitchDiscovery": {
    "PollingInterval": "00:05:00",
    "CleanupInterval": "06:00:00",
    "MaxRetryAttempts": 3,
    "RetryDelay": "00:00:02"
  },
  "TwitchEnrichment": {
    "PollingInterval": "00:05:00",
    "StreamerMaxRetryCount": 3,
    "GameMaxRetryCount": 3,
    "MaxConcurrentRequests": 4
  }
}
